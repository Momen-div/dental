# Production requirements (values are examples/placeholders; generate secrets yourself).
NODE_ENV=production
PORT=3000
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-random-secret-at-least-32-bytes
# Set to the absolute path on the host's mounted persistent volume.
APPOINTMENTS_DB_PATH=/mnt/clinic-data/appointments.db
# Keep backups outside the web root; configure an off-host destination separately.
BACKUP_DIR=/mnt/clinic-backups
BACKUP_RETENTION_DAYS=30
# Set only to the actual trusted proxy hop count/IP/subnet for your hosting platform.
# TRUST_PROXY=1
